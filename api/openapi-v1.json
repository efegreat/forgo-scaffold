{
  "openapi": "3.1.0",
  "info": {
    "title": "Orders API",
    "description": "Places and reads orders.",
    "version": "v1"
  },
  "paths": {
    "/v1/orders": {
      "post": {
        "operationId": "place_order",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "Identifies the request in the server's logs. A missing ID, or one longer than 128 bytes or with characters other than visible ASCII, is replaced with a new one.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "quantity": {
                    "allOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "minimum": 1
                      }
                    ]
                  },
                  "sku": {
                    "type": "string"
                  }
                },
                "required": [
                  "sku"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests admitted at once.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests admitted now.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until RateLimit-Limit requests are admitted again.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "reqId": {
                      "type": "string"
                    },
                    "result": {
                      "$ref": "#/components/schemas/PlaceResp"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests admitted at once.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests admitted now.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until RateLimit-Limit requests are admitted again.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "Retry-After": {
                "description": "Seconds until a request is admitted again.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "errCode": {
                      "type": "string"
                    },
                    "errMsg": {
                      "type": "string"
                    },
                    "reqId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests admitted at once.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests admitted now.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until RateLimit-Limit requests are admitted again.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "errCode": {
                      "type": "string"
                    },
                    "errMsg": {
                      "type": "string"
                    },
                    "reqId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{id}": {
      "get": {
        "operationId": "get_order",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "Identifies the request in the server's logs. A missing ID, or one longer than 128 bytes or with characters other than visible ASCII, is replaced with a new one.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "reqId": {
                      "type": "string"
                    },
                    "result": {
                      "$ref": "#/components/schemas/GetResp"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "errCode": {
                      "type": "string"
                    },
                    "errMsg": {
                      "type": "string"
                    },
                    "reqId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetResp": {
        "properties": {
          "id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "quantity",
          "sku",
          "status"
        ],
        "type": "object"
      },
      "PlaceResp": {
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    }
  }
}
